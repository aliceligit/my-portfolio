---
// CaseStudyHeroScene — a case study hero built from a photo: one wide rounded
// card holding the picture, with the title and details underneath
// (CaseStudyIntro).
//
// The picture is a single image exported from Figma, so there is nothing to
// line up here — to change it, re-export the Hero frame and replace the file
// named in src/content/.
import CaseStudyIntro from "./CaseStudyIntro.astro";

interface Fact {
  label: string;
  value: string;
}

interface Props {
  title: string;
  image: string;
  alt: string;
  facts: Fact[];
}

const { title, image, alt, facts } = Astro.props;
---

<section class="fare-hero">
  <div class="fare-hero__card">
    <img class="fare-hero__image" src={image} alt={alt} />
  </div>

  <CaseStudyIntro title={title} facts={facts} />
</section>

<style>
  .fare-hero {
    width: min(1280px, 100%);
    /* The gap above is shared with the overlay nav's drop, so the header lines
       up with the top of the card. Change it in tokens.css. */
    margin: var(--space-hero-top) auto 0;
  }

  .fare-hero__card {
    /* Same shape as the Figma frame: 1280 wide by 781 tall. Keeping it as a
       ratio means the picture never crops as the page narrows. */
    aspect-ratio: 1280 / 781;
    overflow: hidden;
    border-radius: var(--scale-400); /* 16px */
    background: var(--surface-placeholder);
  }

  .fare-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
