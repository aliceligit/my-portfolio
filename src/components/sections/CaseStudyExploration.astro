---
// CaseStudyExploration — Section 4 of a case study: the numbered heading, then
// one row per design option. Each row pairs a phone playing that option with
// the writing about it, joined by a thin line, and the rows alternate sides.
//
// The words, the recordings and which side each phone sits on all come from
// the case study's file in src/content/.
//
// Each recording is a silent, looping video rather than a GIF: far smaller for
// the same pictures, and unlike a GIF it can be stopped. The script at the
// bottom uses that to play each one only while it is on screen, and not at all
// for readers who ask for less movement.
import CaseStudyHeading from "./CaseStudyHeading.astro";

interface Option {
  title: string;
  body: string[];
  video: string;
  poster: string;
  alt: string;
  phoneSide: "left" | "right";
}

interface Props {
  eyebrow: string;
  headline: string;
  options: Option[];
}

const { eyebrow, headline, options } = Astro.props;

// The image folders have spaces in their names; a path has to be escaped so
// browsers read it as one address.
const url = (path: string) => encodeURI(path);
---

<section class="exploration">
  <CaseStudyHeading eyebrow={eyebrow} headline={headline} maxWidth="623px" />

  <div class="exploration__options">
    {
      options.map((option) => (
        <div
          class:list={[
            "exploration__row",
            `exploration__row--phone-${option.phoneSide}`,
          ]}
        >
          <div class="exploration__phone">
            <video
              class="exploration__video"
              src={url(option.video)}
              poster={url(option.poster)}
              aria-label={option.alt}
              muted
              loop
              playsinline
              preload="none"
              tabindex="0"
              controlslist="nodownload noplaybackrate"
              disablepictureinpicture
            />
          </div>

          <span class="exploration__connector" aria-hidden="true" />

          <div class="exploration__text">
            <p class="exploration__title">{option.title}</p>
            {option.body.map((paragraph) => (
              <p class="exploration__body">{paragraph}</p>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // The player bar — play/pause, the progress slider, the timings — is the
  // browser's own. It stays hidden so the mockup isn't covered, and appears
  // while the reader's pointer is over the phone. It also stays put whenever
  // the recording is stopped, so it can be scrubbed and restarted, and on
  // touch screens, where there is no pointer to hover with.
  const quiet = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover)").matches;

  for (const phone of document.querySelectorAll<HTMLElement>(
    ".exploration__phone",
  )) {
    const video = phone.querySelector<HTMLVideoElement>(".exploration__video");
    if (!video) continue;

    // True while the page itself has the recording stopped because it is off
    // screen — as opposed to the reader pressing pause.
    let pausedByPage = false;
    // Once the reader has paused it themselves, the page never restarts it.
    let pausedByReader = false;

    const show = () => {
      video.controls = true;
    };
    // Keep the bar while the recording is stopped, so it can be started again
    const hide = () => {
      if (!video.paused) video.controls = false;
    };

    if (canHover && !quiet) {
      phone.addEventListener("pointerenter", show);
      phone.addEventListener("pointerleave", hide);
      // Reachable by keyboard too, not only by pointer
      video.addEventListener("focus", show);
      video.addEventListener("blur", hide);
    } else {
      // No hovering to do, or movement isn't wanted: leave the bar showing
      video.controls = true;
    }

    video.addEventListener("pause", () => {
      if (pausedByPage) return;
      pausedByReader = true;
      show();
    });
    video.addEventListener("play", () => {
      pausedByReader = false;
    });

    // A GIF can never be stopped. A video can, so readers who have asked their
    // device for less movement get a still frame they can start themselves,
    // rather than movement they didn't want.
    if (quiet) continue;

    const play = () => {
      if (pausedByReader) return;
      pausedByPage = false;
      // Some devices refuse to start a video on their own (an iPhone in Low
      // Power Mode, for one). Then the play button is left showing, so the
      // reader can start it with a tap instead of looking at a still frame.
      video.play().catch(show);
    };

    // Nothing downloads until the phone is about a screen away, so the page
    // opens without fetching recordings nobody is looking at yet. It plays
    // while on screen and stops when scrolled away.
    let onScreen = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.preload = "auto";
      },
      { rootMargin: "100% 0px" },
    ).observe(phone);
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) play();
      else if (!video.paused) {
        pausedByPage = true;
        video.pause();
      }
    }).observe(phone);

    // If the recording wasn't ready when it came on screen, start it as soon
    // as it is.
    video.addEventListener("canplay", () => {
      if (onScreen && video.paused) play();
    });
  }
</script>

<style>
  .exploration {
    width: min(1280px, 100%);
    margin: var(--spacing-l) auto 0; /* 40px below the section above */
    padding: var(--scale-600); /* 24px */
    border-radius: var(--scale-400); /* 16px */
    background: var(--surface-secondary);
  }

  .exploration__options {
    display: flex;
    flex-direction: column;
    gap: var(--scale-600); /* 24px between the two rows */
    /* The rows never run wider than they do in the design, however wide the
       page gets. At the 1280px design width the margins below already come to
       exactly this, so nothing changes there. */
    max-width: 955.87px;
    /* The rows sit inside the heading's left edge, as in the design */
    margin: var(--space-section-lg) 10% 0 12.4%; /* 80px below the heading */
  }

  /* ----- One option ----- */

  .exploration__row {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-m); /* 16px */
  }

  .exploration__row--phone-right {
    flex-direction: row-reverse;
  }

  /* ----- The phone ----- */

  .exploration__phone {
    flex-shrink: 0;
    /* border-box, so the outline sits inside the 230px rather than adding to it */
    box-sizing: border-box;
    width: 230px;
    /* The same shape as the recording, so the row never changes height while
       the file is still loading */
    aspect-ratio: 230 / 497;
    overflow: hidden;
    /* The recordings are mostly white app screens on a light grey section, so
       without this line their edges disappear into the background — the same
       problem the framed screenshots in Section 1 don't have. */
    border: 3px solid var(--border-device);
    border-radius: var(--scale-600); /* 24px */
    background: var(--surface-placeholder);
  }

  .exploration__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ----- The line joining the phone to the writing -----
     It lines up with the middle of the option's title, and its dot sits at the
     phone end. Drawn here rather than kept as a file, since it is one line and
     one circle. */

  .exploration__connector {
    position: relative;
    flex: 1;
    height: 10px;
    /* Drops the line to the middle of the title's first line */
    margin-top: 76px;
  }

  .exploration__connector::before {
    content: "";
    position: absolute;
    top: 50%;
    height: var(--scale-25); /* 1px */
    background: var(--color-grey-dark-grey);
  }

  .exploration__connector::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-grey-dark-grey);
    transform: translateY(-50%);
  }

  .exploration__row--phone-left .exploration__connector::before {
    left: 10px;
    right: 0;
  }

  .exploration__row--phone-left .exploration__connector::after {
    left: 0;
  }

  .exploration__row--phone-right .exploration__connector::before {
    left: 0;
    right: 10px;
  }

  .exploration__row--phone-right .exploration__connector::after {
    right: 0;
  }

  /* ----- The writing ----- */

  .exploration__text {
    flex-shrink: 0;
    width: 500px;
    /* Sits a little below the top of the phone, as in the design */
    margin-top: 64px;
  }

  .exploration__title {
    margin: 0 0 var(--scale-200); /* 8px */
    font-family: var(--text-style-body-emphasized-family);
    font-weight: var(--text-style-body-emphasized-weight);
    font-size: var(--text-style-body-emphasized-size);
    line-height: var(--text-style-body-emphasized-line-height);
    color: var(--text-primary);
  }

  .exploration__body {
    margin: 0;
    font-family: var(--text-style-body-family);
    font-weight: var(--text-style-body-weight);
    font-size: var(--text-style-body-size);
    line-height: var(--text-style-body-line-height);
    color: var(--text-primary);
  }

  /* A blank line between paragraphs, as in the design */
  .exploration__body + .exploration__body {
    margin-top: var(--text-style-body-line-height);
  }

  /* ----- Smaller screens -----
     The writing narrows before anything else, so the phone keeps its size and
     the joining line keeps a length you can actually see. Without the basis on
     the writing it takes every spare pixel and squeezes the line to nothing. */
  @media (max-width: 1279px) {
    .exploration__options {
      /* Below the design width there is no room for the design's insets, so
         the rows simply centre once they reach their full width. */
      margin-inline: auto;
    }

    .exploration__text {
      flex: 0 1 500px;
      width: auto;
      min-width: 0;
    }

    .exploration__connector {
      /* Never shorter than this — the writing gives up the width instead */
      min-width: 70px;
    }
  }

  /* ----- Narrower than a small laptop -----
     The rows pull in further, so they don't run the full width of the card. */
  @media (max-width: 1089px) {
    .exploration__options {
      max-width: 880px;
    }
  }

  /* ----- Phones -----
     Tablets keep the row and its joining line; only below this does a row
     leave the writing a few words wide, so the phone sits above its writing
     and the line is dropped. */
  @media (max-width: 699px) {
    /* More air under the last paragraph than the 24px the wider layouts use */
    .exploration {
      padding-bottom: var(--spacing-l); /* 40px */
    }

    /* and more between one option and the next */
    .exploration__options {
      gap: var(--spacing-l); /* 40px */
    }

    .exploration__row,
    .exploration__row--phone-right {
      flex-direction: column;
      align-items: center;
      gap: var(--scale-600); /* 24px — a phone stays close to its own writing */
    }

    .exploration__connector {
      display: none;
    }

    .exploration__text {
      /* Back to sizing from its own content. The 500px the rows give it is a
         width when they sit side by side, but here the row is a column, so
         that number would become a height and leave a tall empty gap under
         every paragraph. */
      flex: 0 0 auto;
      width: 100%;
      margin-top: 0;
    }
  }
</style>
