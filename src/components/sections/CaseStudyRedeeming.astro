---
// "Smooth Redeeming" — the fifth section of the case study.
//
// One grey card: the heading and the story on the left, one picture on the
// right. The words and the picture live in src/content/brightlineLoyalty.ts.
import CaseStudyHeading from "./CaseStudyHeading.astro";
import { brightlineRedeeming } from "../../content/brightlineLoyalty";

const { eyebrow, headline, paragraphs, media, alt } = brightlineRedeeming;

const isVideo = (file: string) => file.toLowerCase().endsWith(".mp4");
---

<section class="redeeming">
  <div class="redeeming__story">
    <CaseStudyHeading eyebrow={eyebrow} headline={headline} />
    <div class="redeeming__prose">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <div class="redeeming__figure">
    {
      media &&
        (isVideo(media) ? (
          <video
            class="redeeming__media"
            src={media}
            loop
            muted
            playsinline
            preload="metadata"
          />
        ) : (
          <img
            class="redeeming__media"
            src={media}
            alt={alt}
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>
</section>

<style>
  .redeeming {
    /* Grid, not flex: the two halves keep the design's 639 : 554 proportions
       at any width — the same split as the section above. */
    display: grid;
    grid-template-columns: minmax(0, 639fr) minmax(0, 553fr);
    gap: var(--spacing-l); /* 40px */
    align-items: start;
    width: min(1280px, 100%);
    margin: var(--scale-1000) auto 0; /* 40px below the section above */
    padding: var(--scale-600); /* 24px */
    background: var(--surface-secondary);
    border-radius: var(--radius-m); /* 16px */
    color: var(--text-primary);
  }

  /* ----- Left: the story ----- */

  .redeeming__story {
    display: flex;
    flex-direction: column;
    gap: var(--scale-600); /* 24px under the heading */
    min-width: 0;
  }

  .redeeming__prose {
    display: flex;
    flex-direction: column;
    /* A blank line between the two paragraphs, as in the design */
    gap: var(--text-style-body-line-height);
  }

  .redeeming__prose p {
    margin: 0;
    font-family: var(--text-style-body-family);
    font-weight: var(--text-style-body-weight);
    font-size: var(--text-style-body-size);
    line-height: var(--text-style-body-line-height);
  }

  /* ----- Right: the picture ----- */

  .redeeming__figure {
    aspect-ratio: 554 / 422;
    overflow: hidden;
    background: var(--surface-primary);
    border-radius: var(--radius-m); /* 16px */
    /* Nudged down so the card starts level with the headline, as designed */
    margin-top: var(--scale-1000); /* 40px */
  }

  .redeeming__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ----- Phones: the picture drops below the story ----- */

  @media (max-width: 899px) {
    .redeeming {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--scale-600); /* 24px */
    }

    .redeeming__figure {
      margin-top: 0; /* the grid gap already spaces it */
    }
  }
</style>
