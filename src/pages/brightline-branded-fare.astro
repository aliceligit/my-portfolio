---
// Case study: Brightline Branded Fares — lives at /brightline-branded-fare
// Copy and images come from src/content/brightlineBrandedFare.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyHeroScene from "../components/sections/CaseStudyHeroScene.astro";
import CaseStudyProblem from "../components/sections/CaseStudyProblem.astro";
import CaseStudyGoal from "../components/sections/CaseStudyGoal.astro";
import CaseStudyCompetitive from "../components/sections/CaseStudyCompetitive.astro";
import CaseStudyExploration from "../components/sections/CaseStudyExploration.astro";
import {
  brandedFareHero,
  brandedFareProblem,
  brandedFareGoal,
  brandedFareCompetitive,
  brandedFareExploration,
} from "../content/brightlineBrandedFare";
---

<BaseLayout title="Brightline Branded Fares — Alice Li" overlayNav>
  <CaseStudyHeroScene
    title={brandedFareHero.title}
    image={brandedFareHero.image}
    imageWebp={brandedFareHero.imageWebp}
    alt={brandedFareHero.alt}
    facts={brandedFareHero.facts}
  />
  <CaseStudyProblem
    eyebrow={brandedFareProblem.eyebrow}
    headline={brandedFareProblem.headline}
    body={brandedFareProblem.body}
    slides={brandedFareProblem.slides}
    arrow={brandedFareProblem.arrow}
  />
  <CaseStudyGoal
    eyebrow={brandedFareGoal.eyebrow}
    headline={brandedFareGoal.headline}
  />
  <CaseStudyCompetitive
    eyebrow={brandedFareCompetitive.eyebrow}
    headline={brandedFareCompetitive.headline}
    insightsLabel={brandedFareCompetitive.insightsLabel}
    body={brandedFareCompetitive.body}
    chart={brandedFareCompetitive.chart}
  />
  <CaseStudyExploration
    eyebrow={brandedFareExploration.eyebrow}
    headline={brandedFareExploration.headline}
    options={brandedFareExploration.options}
  />
</BaseLayout>
